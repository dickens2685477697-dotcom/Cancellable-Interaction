      "elements": [
        {
          "text_run": {
            "content": "固定回调 50 Hz（20 ms）不等于每秒收到 50 次新的手部更新。旧代码没有核验 MRTK 更新身份；同一缓存位置再次参与差分时，速度为 0，前次速度非零时还会得到负加速度。",
            "text_element_style": {}
          }
        }
      ]
    }
  },
  {
    "block_type": 4,
    "heading2": {
      "elements": [
        {
          "text_run": {
            "content": "2. 现有数据中的问题",
