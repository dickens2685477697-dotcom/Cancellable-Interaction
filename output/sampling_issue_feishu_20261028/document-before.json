      "parent_id": "WNCJdIhNaoVqg6xA6Q8c1oBrn2I",
      "text": {
        "elements": [
          {
            "text_run": {
              "content": "发现背景：2026-10-25 旧实现对比实验。",
              "text_element_style": {
                "bold": true,
                "inline_code": false,
                "italic": false,
                "strikethrough": false,
                "underline": false
              }
            }
          },
          {
            "text_run": {
              "content": "动态模式正常选择有 16/48 次、球内持续画圈有 44/48 次在零速记录上触发；这 60 次均呈现同渲染帧、连续固定步位置重复。当时 Magic Tap 2.0 会跳过不足 1 mm 位移（位移小于1 mm，就跳过本次运动计算和触发判断），两者预处理不同，旧结果不能单独归因于动态阈值策略。",
              "text_element_style": {
                "bold": false,
                "inline_code": false,
                "italic": false,
                "strikethrough": false,
                "underline": false
              }
            }
